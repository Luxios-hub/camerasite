<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title><%= title %> | CamerasNYC Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700;800&family=Schibsted+Grotesk:wght@600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/admin/css/admin.css">
  </head>
  <body>
    <% if (adminUser) { %>
      <header class="admin-shellbar">
        <a class="admin-shellbar__brand" href="/admin">CamerasNYC Admin</a>
        <nav class="admin-shellbar__nav" aria-label="Admin">
          <a href="/admin">Dashboard</a>
          <a href="/admin/visual/home">Visual editor</a>
          <a href="/admin/settings">Settings</a>
          <a href="/admin/pages">Pages</a>
          <a href="/admin/leads">Leads</a>
          <a href="/admin/media">Media</a>
        </nav>
        <span class="admin-shellbar__user"><%= adminUser.displayName %></span>
      </header>
    <% } %>
    <%- body %>
  </body>
</html>
