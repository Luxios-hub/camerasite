<% const visualMode = typeof adminPreview !== 'undefined' && adminPreview && adminPreview.enabled; %>
<% const preview = visualMode ? adminPreview : {
  blockEditUrl: () => '',
  blockLabel: () => '',
  itemEditUrl: () => '',
  itemLabel: () => ''
}; %>
<% const pageHeader = blocksByKey.page_header || page; %>
<header class="page-head" <% if (visualMode) { %>data-admin-visual-region="page_header"<% } %>>
  <%- include('../partials/admin/visualEditControl', {
    label: 'Edit page header',
    href: blocksByKey.page_header ? preview.blockEditUrl('page_header') : preview.editPageUrl
  }) %>
  <div class="container">
    <% if (pageHeader.eyebrow || page.headerEyebrow) { %>
      <p class="eyebrow page-head__eyebrow"><%= pageHeader.eyebrow || page.headerEyebrow %></p>
    <% } %>
    <h1 class="page-head__title text-balance"><%= pageHeader.title || page.headerTitle %></h1>
    <% if (pageHeader.lede || page.headerLede) { %>
      <p class="page-head__lede"><%= pageHeader.lede || page.headerLede %></p>
    <% } %>
  </div>
</header>

<% const contactInfo = blocksByKey.contact_info; %>
<% const quoteForm = blocksByKey.quote_form; %>
<% const formSettings = (quoteForm && quoteForm.settings) || {}; %>
<% const quoteState = typeof quoteFormState !== 'undefined' ? quoteFormState : {}; %>
<% const quoteValues = quoteState.values || {}; %>
<% const quoteErrors = quoteState.errors || {}; %>
<% const configuredFormAction = formSettings.action || (settings.contact && settings.contact.formEndpoint) || ''; %>
<% const formAction = typeof configuredFormAction === 'string' && !configuredFormAction.includes('YOUR_FORM_ID') ? configuredFormAction : '/contact/quote'; %>
<%
  const valueFor = (name) => Object.prototype.hasOwnProperty.call(quoteValues, name) ? quoteValues[name] : '';
  const errorFor = (name) => quoteErrors[name] || null;
%>

<section class="section" <% if (visualMode) { %>data-admin-visual-region="contact"<% } %>>
  <div class="container">
    <div class="contact-layout">
      <% if (contactInfo) { %>
        <aside class="contact-info" <% if (visualMode) { %>data-admin-visual-region="contact_info"<% } %>>
          <%- include('../partials/admin/visualEditControl', {
            label: 'Edit ' + preview.blockLabel(contactInfo),
            href: preview.blockEditUrl('contact_info')
          }) %>
          <% for (const item of items('contact_info')) { %>
            <div class="contact-info__group<%= visualMode ? ' admin-visual-item-frame' : '' %>" <% if (visualMode) { %>data-admin-visual-item="<%= item.itemKey || item.id %>"<% } %>>
              <h4><%= item.title %></h4>
              <% if (item.linkUrl && item.linkLabel && item.itemKey === 'whatsapp') { %>
                <% const contactHref = safeUrl(item.linkUrl); %>
                <a href="<%= contactHref %>" <% if (isExternalUrl(contactHref)) { %>target="_blank" rel="noopener"<% } %> class="btn btn--whatsapp" style="margin-top: var(--space-2);"><%= item.linkLabel %></a>
              <% } else if (item.linkUrl && item.linkLabel) { %>
                <a href="<%= safeUrl(item.linkUrl) %>" class="contact-info__phone"><%= item.linkLabel %></a>
              <% } %>
              <% if (item.body) { %>
                <p style="margin-top: var(--space-2); font-size: var(--fs-sm);">
                  <% const lines = String(item.body).split(/\n/); %>
                  <% for (let index = 0; index < lines.length; index += 1) { %>
                    <% if (index > 0) { %><br /><% } %><%= lines[index] %>
                  <% } %>
                </p>
              <% } %>
              <%- include('../partials/admin/visualEditControl', {
                label: 'Edit ' + preview.itemLabel(item) + ' item',
                href: preview.itemEditUrl('contact_info', item),
                className: 'admin-visual-edit--item'
              }) %>
            </div>
          <% } %>
        </aside>
      <% } %>

      <% if (quoteForm) { %>
        <div class="form-card" <% if (visualMode) { %>data-admin-visual-region="quote_form"<% } %>>
          <%- include('../partials/admin/visualEditControl', {
            label: 'Edit ' + preview.blockLabel(quoteForm),
            href: preview.blockEditUrl('quote_form')
          }) %>
          <% if (quoteForm.eyebrow) { %><p class="eyebrow section-head__eyebrow"><%= quoteForm.eyebrow %></p><% } %>
          <h2 class="section-head__title" style="font-size: var(--fs-xl); margin-bottom: var(--space-5);"><%= quoteForm.title %></h2>

          <% if (quoteState.status === 'success') { %>
            <div class="form-message form-message--success" role="status">
              Thanks, your quote request has been received. We will respond within one business day.
            </div>
          <% } else if (quoteState.generalError) { %>
            <div class="form-message form-message--error" role="alert">
              <%= quoteState.generalError %>
            </div>
          <% } %>

          <form action="<%= safeUrl(formAction, '/contact/quote') %>" method="<%= safeFormMethod(formSettings.method || 'POST') %>" class="form-grid" name="<%= safeFormName(formSettings.formName || 'quote') %>">
            <% if (formSettings.honeypotField) { %>
              <input type="text" name="<%= safeFormName(formSettings.honeypotField, 'bot-field') %>" tabindex="-1" autocomplete="off" style="position:absolute; left:-9999px;" aria-hidden="true" />
            <% } %>

            <% const fields = formSettings.fields || []; %>
            <% for (let fieldIndex = 0; fieldIndex < fields.length; fieldIndex += 1) { %>
              <% const field = fields[fieldIndex]; %>
              <% const fieldAttrs = safeFormField(field, fieldIndex); %>
              <% const fieldValue = valueFor(fieldAttrs.name); %>
              <% const fieldError = errorFor(fieldAttrs.name); %>
              <% if (fieldAttrs.type === 'select') { %>
                <% const options = fieldAttrs.sourceName === 'type' ? (formSettings.propertyTypes || []) : (formSettings.cameraCounts || []); %>
                <div class="form-field">
                  <label for="<%= fieldAttrs.id %>"><%= field.label %></label>
                  <select
                    id="<%= fieldAttrs.id %>"
                    name="<%= fieldAttrs.name %>"
                    <% if (fieldAttrs.required) { %>required<% } %>
                    <% if (fieldError) { %>aria-invalid="true" aria-describedby="<%= fieldAttrs.id %>-error"<% } %>
                  >
                    <option value="" <% if (fieldValue === '') { %>selected<% } %>><%= fieldAttrs.sourceName === 'type' ? 'Select...' : (options[0] || 'Not sure yet') %></option>
                    <% for (const option of (fieldAttrs.sourceName === 'cameras' ? options.slice(1) : options)) { %>
                      <option value="<%= option %>" <% if (fieldValue === option) { %>selected<% } %>><%= option %></option>
                    <% } %>
                  </select>
                  <% if (fieldError) { %>
                    <p class="form-field__error" id="<%= fieldAttrs.id %>-error" data-field-error-for="<%= fieldAttrs.name %>"><%= fieldError %></p>
                  <% } %>
                </div>
              <% } else if (fieldAttrs.type === 'textarea') { %>
                <div class="form-field form-field--full">
                  <label for="<%= fieldAttrs.id %>"><%= field.label %></label>
                  <textarea
                    id="<%= fieldAttrs.id %>"
                    name="<%= fieldAttrs.name %>"
                    placeholder="<%= formSettings.placeholder || '' %>"
                    <% if (fieldError) { %>aria-invalid="true" aria-describedby="<%= fieldAttrs.id %>-error"<% } %>
                  ><%= fieldValue %></textarea>
                  <% if (fieldError) { %>
                    <p class="form-field__error" id="<%= fieldAttrs.id %>-error" data-field-error-for="<%= fieldAttrs.name %>"><%= fieldError %></p>
                  <% } %>
                </div>
              <% } else { %>
                <div class="form-field">
                  <label for="<%= fieldAttrs.id %>"><%= field.label %></label>
                  <input
                    type="<%= fieldAttrs.type %>"
                    id="<%= fieldAttrs.id %>"
                    name="<%= fieldAttrs.name %>"
                    value="<%= fieldValue %>"
                    <% if (fieldAttrs.required) { %>required<% } %>
                    <% if (fieldAttrs.autocomplete) { %>autocomplete="<%= fieldAttrs.autocomplete %>"<% } %>
                    <% if (fieldAttrs.pattern) { %>pattern="<%= fieldAttrs.pattern %>"<% } %>
                    <% if (fieldAttrs.maxlength) { %>maxlength="<%= fieldAttrs.maxlength %>"<% } %>
                    <% if (fieldAttrs.inputmode) { %>inputmode="<%= fieldAttrs.inputmode %>"<% } %>
                    <% if (fieldError) { %>aria-invalid="true" aria-describedby="<%= fieldAttrs.id %>-error"<% } %>
                  />
                  <% if (fieldError) { %>
                    <p class="form-field__error" id="<%= fieldAttrs.id %>-error" data-field-error-for="<%= fieldAttrs.name %>"><%= fieldError %></p>
                  <% } %>
                </div>
              <% } %>
            <% } %>

            <div class="form-actions form-field--full">
              <button type="submit" class="btn btn--blue btn--icon">Request quote</button>
              <% if (quoteForm.body) { %><p class="form-actions__note"><%= quoteForm.body %></p><% } %>
            </div>
          </form>
        </div>
      <% } %>
    </div>
  </div>
</section>
