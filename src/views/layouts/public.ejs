<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/public/head') %>
  <% if (typeof adminPreview !== 'undefined' && adminPreview && adminPreview.enabled) { %>
    <link rel="stylesheet" href="/admin/css/visual-editor.css" />
  <% } %>
</head>
<body class="<%= typeof adminPreview !== 'undefined' && adminPreview && adminPreview.enabled ? 'admin-visual-body' : '' %>">
  <% if (typeof adminPreview !== 'undefined' && adminPreview && adminPreview.enabled) { %>
    <%- include('../partials/admin/visualToolbar') %>
  <% } %>

  <%- include('../partials/public/trustBar') %>
  <%- include('../partials/public/nav') %>

  <%- body %>

  <%- include('../partials/public/footer') %>
  <script src="/js/main.js" defer></script>
  <% if (typeof adminPreview !== 'undefined' && adminPreview && adminPreview.enabled) { %>
    <script src="/admin/js/visual-editor.js" defer></script>
  <% } %>
</body>
</html>
